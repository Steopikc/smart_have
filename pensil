PRAGMA foreign_keys = OFF;
BEGIN TRANSACTION;
CREATE TABLE IF NOT EXISTS apiaries (
apiary_id INTEGER PRIMARY KEY,
name TEXT NOT NULL,
district TEXT NOT NULL,
latitude REAL NOT NULL,
longitude REAL NOT NULL,
registration_number TEXT NOT NULL,
honey_collection_site TEXT NOT NULL,
vet_certificate_number TEXT NOT NULL,
vet_certificate_valid_until TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS hives (
hive_id INTEGER PRIMARY KEY,
apiary_id INTEGER NOT NULL,
cluster_id INTEGER NOT NULL,
hive_code TEXT NOT NULL,
bee_subspecies TEXT NOT NULL,
colony_origin TEXT NOT NULL,
queen_year INTEGER NOT NULL,
colony_vet_passport TEXT NOT NULL,
FOREIGN KEY (apiary_id) REFERENCES apiaries(apiary_id)
);
CREATE TABLE IF NOT EXISTS daily_weather (
weather_id INTEGER PRIMARY KEY,
apiary_id INTEGER NOT NULL,
record_date TEXT NOT NULL,
ambient_temp_c REAL NOT NULL,
ambient_humidity_pct REAL NOT NULL,
precipitation_mm REAL NOT NULL,
wind_speed_ms REAL NOT NULL,
weather_condition TEXT NOT NULL,
forecast_next_day_temp_c REAL NOT NULL,
forecast_next_day_condition TEXT NOT NULL,
FOREIGN KEY (apiary_id) REFERENCES apiaries(apiary_id)
);
CREATE TABLE IF NOT EXISTS hive_sensor_logs (
log_id INTEGER PRIMARY KEY,
hive_id INTEGER NOT NULL,
record_date TEXT NOT NULL,
internal_temp_c REAL NOT NULL,
internal_humidity_pct REAL NOT NULL,
co2_ppm INTEGER NOT NULL,
hive_weight_kg REAL NOT NULL,
daily_weight_delta_kg REAL NOT NULL,
lid_opened_count INTEGER NOT NULL,
lid_event_cause TEXT NOT NULL,
is_tipped_over INTEGER NOT NULL,
tipping_cause TEXT NOT NULL,
sound_level_db REAL NOT NULL,
bee_activity_index INTEGER NOT NULL,
estimated_flights_count INTEGER NOT NULL,
ambient_temp_c REAL NOT NULL,
anomaly_flag INTEGER NOT NULL,
anomaly_description TEXT,
FOREIGN KEY (hive_id) REFERENCES hives(hive_id)
);
